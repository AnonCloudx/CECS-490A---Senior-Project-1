label = 0   # 0 = none, 1 = pee, 2 = poop
SAMPLE_MS = 100
 
 
def update_display():
    if label == 1:
        basic.show_number(1)
    elif label == 2:
        basic.show_number(2)
    else:
        basic.show_icon(IconNames.SMALL_DIAMOND)
 
 
def alert():
    basic.show_icon(IconNames.NO)
    for i in range(3):
        pins.digital_write_pin(DigitalPin.P1, 1)
        basic.pause(150)
        pins.digital_write_pin(DigitalPin.P1, 0)
        basic.pause(100)
    update_display()
 
 
def on_button_pressed_a():
    global label
    if label == 1:
        label = 0
    else:
        label = 1
    update_display()
input.on_button_pressed(Button.A, on_button_pressed_a)
 
 
def on_button_pressed_b():
    global label
    if label == 2:
        label = 0
    else:
        label = 2
    update_display()
input.on_button_pressed(Button.B, on_button_pressed_b)
 
 
def on_button_pressed_ab():
    alert()
input.on_button_pressed(Button.AB, on_button_pressed_ab)
 
 
def send_motion():
    serial.write_line(
        str(input.running_time()) + "," +
        str(input.acceleration(Dimension.X)) + "," +
        str(input.acceleration(Dimension.Y)) + "," +
        str(input.acceleration(Dimension.Z)) + "," +
        str(input.acceleration(Dimension.STRENGTH)) + "," +
        str(label))
loops.every_interval(SAMPLE_MS, send_motion)
 
 
serial.set_baud_rate(BaudRate.BAUD_RATE115200)
serial.write_line("time_ms,x,y,z,strength,label")
pins.digital_write_pin(DigitalPin.P1, 0)
update_display()
 
